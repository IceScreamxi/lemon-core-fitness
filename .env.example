# Google Sheets API Configuration
# Get your credentials from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project
# 3. Enable Google Sheets API
# 4. Create service account credentials
# 5. Download the JSON file and save it as credentials.json
# 6. Share your Google Sheet with the service account email (Editor permissions)

# For local development, set this to the path to your credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# For production deployment, set this to the base64 encoded credentials
# You can encode your credentials.json file using:
# echo -n "$(cat credentials.json)" | base64 -w 0
GOOGLE_CREDENTIALS_BASE64=